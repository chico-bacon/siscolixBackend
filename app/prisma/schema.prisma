generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./siscolix.db"
}

/**
 * enum Semana {
 * DOMINGO
 * SEGUNDA
 * TERÇA
 * QUARTA
 * QUINTA
 * SEXTA
 * SABADO
 * }
 */
/**
 * enum Status {
 * PENDENTE
 * MOVIMENTANDO
 * FINALIZADO
 * }
 */

enum Status {
  CRIADO
  RECUSADO
  AGUARDANDO_ROTA
  EM_ROTA_PARA_COLETA
  FINALIZADO
}

enum TipoChamado {
  PODA
  ENTULHO
}

enum Nivel {
  USUARIO
  ADMINISTRADOR
}

enum Situacao {
  ATIVO
  INATIVO
}

model Bairro {
  id            Int    @id @default(autoincrement())
  nome          String
  situacao      Situacao @default(ATIVO)
  Rota Rota[]
}

model Rota {
  id        Int    @id @default(autoincrement())
  descricao String
  bairro    Bairro @relation(fields: [id_bairro], references: [id])
  id_bairro Int
  dias      String
  turnos    String
  situacao  Situacao @default(ATIVO)
}

/**
 * model Agenda {
 * id        Int    @id @default(autoincrement())
 * coleta    Coleta @relation(fields: [id_coleta], references: [id])
 * id_coleta Int
 * }
 */
model Chamado {
  id               Int         @id @default(autoincrement())
  //status           Status      @default(PENDENTE)
  usuario_id       String
  tipoChamado      TipoChamado @default(PODA)
  bairro_id        Int
  logradouro       String
  ponto_referencia String?
}

model FluxoChamado {
  id           Int      @id @default(autoincrement())
  chamado_id   Int
  admin_id     String?
  status       Status
  dataPrevista String?
  dataRegistro DateTime
}

/**
 * /model ChamadoLog {
 * id
 * chamdado_id
 * dataAlteracao
 * status           Status      @default(PENDENTE)
 * }
 */

model Artigo {
  id             Int      @id @default(autoincrement())
  situacao       Situacao @default(ATIVO)
  dataPublicacao String
  manchete       String
  conteudo       String
}

model Usuario {
  id             String   @id @default(uuid())
  nome           String
  cpf            String   @unique
  dataNascimento String
  email          String   @unique
  telefone       String
  nivel          Nivel    @default(USUARIO)
  senha          String
  situacao       Situacao @default(ATIVO)
}
