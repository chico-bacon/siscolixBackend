generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./siscolix.db"
}

model Bairro {
  id   Int    @id @default(autoincrement())
  nome String

  Cronograma Cronograma[]
}

model Cronograma {
  id            Int    @id @default(autoincrement())
  bairro        Bairro @relation(fields: [id_bairro], references: [id])
  id_bairro     Int
  periodicidade Json
}
