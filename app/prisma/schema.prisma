// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./siscolix.db"
}

model Bairro {
  id         Int          @id @default(autoincrement())
  nome       String
  Coleta Coleta[]
}

model Coleta {
  id            Int    @id @default(autoincrement())
  bairro        Bairro @relation(fields: [id_bairro], references: [id])
  id_bairro     Int
  dia Semana  
  horario DateTime
}

enum Semana {
  DOMINGO
  SEGUNDA
  TERÇA
  QUARTA
  QUINTA
  SEXTA
  SABADO
}

model Artigo {
  id             Int      @id @default(autoincrement())
  dataPublicacao DateTime
  manchete       String
  conteudo       String
}

model Usuario {
  id             String @id @default(uuid())
  nome           String
  cpf            String @unique
  dataNascimento String
  email          String @unique
  telefone       String
  nivel          Nivel  @relation(fields: [id_nivel], references: [id])
  id_nivel       Int
  senha          String
  situacao       Int
}

model Nivel {
  id      Int       @id @default(autoincrement())
  nome    String
  Usuario Usuario[]
}
