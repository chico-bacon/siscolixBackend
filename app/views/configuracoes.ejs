<html lang="pt-br">
<body>
    <%- include('cabecalho') %>

    <main class="telaPrincipal">
        <div class="cabecalhoTela">
            <div class="cabecalhoTelaLeft">
                <div class="tituloCabecalho">
                    <h1>Configurações do Sistema</h1>
                </div>
                <div class="iconeTela">
                    <img src="img\icons\settings.svg" alt="">
                </div>
            </div>
            <div class="cabecalhoTelaRight">
                <div class="div_filtragem">
                    <h3>Por Nome: </h3>                
                    <input type="text" id="f_fitragem" name="f_fitragem" class="campoFiltragem">
                </div>

                <div>
                    <button><img src="img/icons/add.svg" id="btn_add" class="btn_mainoper" title="Adcionar Nova Chave"></button> 
                    <button><img src="img/icons/list.svg" id="btn_listaTodos" class="btn_mainoper" title="Todas os Chaves"></button> 
                    <!-- <label for="pesquisa">Pesquisa</label>
                    <input type="text" name="pesquisa"> -->
                    <button><img src="img/icons/search.svg" id="btn_pesquisa" class="btn_mainoper" title="Pesquisa Chaves"></button> 
                </div>
            </div>
        </div>

        <div class="">
            ITENS DE CONFIGURAÇÃO
            <div class="gridConfiguracoes">
                <table >
                    <tr>
                        <th>Chave</th>
                        <th>Registro</th>
                        <th>Ações</th>
                    </tr>
                    <tbody  class="linhasConfiguracoes">   
                        <tr v-for="configuracao in listaConfiguracoes" :key="configuracao.id" > <!-- class="trlista" -->
                            <td class="chave">{{ configuracao.chave }}</td>
                            <td class="registro">{{ configuracao.registro }}</td>
                            <td class="acoes">
                                <!-- <button   @click="visualizar"></button> -->
                                <img src="/img/icons/visualizar.svg" alt="Visualizar"  @click="visualizar">
                                <img src="/img/icons/editar.svg" alt="Editar"  @click="editar">
                                <img src="/img/icons/deletar.svg" alt="Excluir"  @click="excluir">
                            </td>

                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </main>

    <script type="module">
    import { createApp, ref, reactive } from 'https://unpkg.com/vue@3/dist/vue.esm-browser.prod.js'

    createApp({
        setup() {
            let id=1;
            let listaConfiguracoes = reactive([
                {id: 1, chave: "Link_Site_Prefeitura", registro: "https://paracuru.ce.gov.br/"},
                {id: 2, chave: "Link_Ouvidoria_Prefeitura", registro: "https://paracuru.ce.gov.br/ouvidoria"},
                {id: 3, chave: "Link_Site_Secretaria_Gestao", registro: "https://paracuru.ce.gov.br/secretaria.php?sec=46"}
            ]);
            console.log(listaConfiguracoes);
            return {
                listaConfiguracoes
            }
        }
    }).mount('main')
    </script>

    <%- include('rodape') %>
</body>
</html>