<%- include('cabecalho') %>
<div class="cabecalhoCadastro">
    <button id="btMenu"><a href="\administracao"><img src="\img\icons\menu.svg" alt="Menu"></a></button>
    <p>Cadastro de Usuários</p>
    <div class="filtrar">
        <label for="filtrar">Filtrar por:</label>
        <input type="text" name="filtrar" id="filtrar">
    </div>
    <div class="pesquisar">
        <button><img src="\img\icons\search.svg" alt="" title="Pesquisar"></button>
        <button id="novoRegistro"><img src="\img\icons\add.svg" alt="" title="Novo Registro"></button>
    </div>
</div>
<main>

    <div class="listaDados">
        <table class="tbLista">
            <tr class="cabecalhoLista">
                <th class="thId">id</th>
                <th class="thDescricao">Nome</th>
                <th class="thDescricao">Nível</th>
                <th class="thSituacao">Data de Nascimento</th>
                <th class="thSituacao">E-mail</th>
                <th class="thSituacao">Situação</th>
                <th class="thAcoes">Ações</th>
                <!-- <th></th>
                <th></th> -->
            </tr>
            <tbody  class="linhasCronograma">   
               <tr v-for="usuario in listaUsuarios" :key="usuario.id">
                <td class="tdId">{{ usuario.id }}</td>
                <td class="tdDescricao">{{ usuario.nome }}</td>
                <td class="tdDescricao">{{ usuario.nivel }}</td>
                <td class="tdDescricao">{{ usuario.dataNascimento }}</td>
                <td class="tdDescricao">{{ usuario.email }}</td>
                <!-- <td class="tdDescricao">{{ usuario.telefone }}</td> -->
                <td class="tdSituacao">{{ usuario.situacao }}</td>
                <td class="tdAcoes">
                        <img src="/img/icons/visualizar.svg" @click="visualizar(usuario.id)">
                        <img src="/img/icons/editar.svg" @click="editar(usuario.id)">
                        <img src="/img/icons/deletar.svg"  @click="excluir(usuario.id)">
                    </td>
                </tr>
            </tbody>
        </table>
    </div>



    <!-- ocultaTelaPopupCadastro -->
    <div id="telaPopupCadastro" class="telaPopupCadastro ocultaTelaPopupCadastro"> 
        <div class="telaFormCadastro">
            <h1>Novo Cadastro de Cronograma</h1>
            <button id="cancelar" class="botaoPadrao">Cancelar</button>
            <div class="formCadastro">
                <form @submit.prevent="processaForm()">
                    <input type="text" value="0" id="id">
                    <label for="nome">
                        <span>Nome</span>
                        <input type="text" id="nome" name="nome">
                    </label>
                    <div class="subDivCadastro">
                        <span>
                            <label for="cpf">CPF</label>
                            <input type="text" id="cpf" name="cpfUsuario">
                        </span>
                        <span>
                            <label for="dataNascimento">Data de Nascimento</label>
                            <input type="text" id="dataNascimento" name="Nascimento">
                        </span>
                    </div>


                    <div class="subDivCadastro">
                        <!-- <label>
                            <span>Nome</span>
                            <input name="nome" />
                        </label> -->
                        <label for="email">
                            <span>E-Mail</span>
                            <input type="text" id="email" name="email">
                        </label>
                        <label for="telfone">
                            <span>Telefone</span>
                            <input type="text" id="telefone" name="telefone">
                        </label>
                    </div>
                    <div class="subDivCadastro">
                        <label>
                            <span>Nível</span>
                            <select id="nivel" name="nivel">
                                <option value="ADMINISTRADOR">Administrador</option>
                                <option value="USUARIO">Contribuinte</option>
                            </select>
                        </label>
                        <label>
                            <span>Situação</span>
                            <select id="situacao" name="situacao">
                                <option value="INATIVO">Inatívo</option>
                                <option value="ATIVO">Ativo</option>
                            </select>
                        </label>
                    </div>
                    <div class="div_botoesCadastro">
                        <button id="gravar" class="botaoPadrao">Gravar</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</main>
<script type="module">
    const novoRegistro = document.getElementById('novoRegistro');
    const cancelar = document.getElementById('cancelar');
    const gravar = document.getElementById('gravar');

    novoRegistro.addEventListener("click",(evt)=>{
        telaPopupCadastro.classList.remove("ocultaTelaPopupCadastro");
    });

    cancelar.addEventListener("click",(evt)=>{
        telaPopupCadastro.classList.add("ocultaTelaPopupCadastro");
    });

    gravar.addEventListener("click",(evt)=>{
        console.log('Clicou no Botão Gravar!!!');
    });

    import { createApp, ref, reactive } from 'https://unpkg.com/vue@3/dist/vue.esm-browser.prod.js'
    createApp({
        setup() {
            let listaUsuarios = ref([]);
            async function processaForm(){
                let usuario={
                    id: id.value,
                    nome: nome.value,
                    cpf: cpf.value,
                    dataNascimento: dataNascimento.value,
                    email: email.value,
                    telefone: telefone.value,
                    nivel: nivel.value,
                    situacao: situacao.value,
                    senha: cpf + '124'
                }
                if (id.value == "0") {
                    await fetch('/usuarios', {
                        method: 'POST', // Specify the HTTP method as POST
                        headers: {
                            'Content-Type': 'application/json' // Indicate that the body is JSON
                        },
                        body: JSON.stringify(usuario) // Convert the JavaScript object to a JSON string
                    });
                    
                } else {
                    await fetch(`/administracao/usuarios/${id.value}`, {
                        method: 'PUT', // Specify the HTTP method as POST
                        headers: {
                            'Content-Type': 'application/json' // Indicate that the body is JSON
                        },
                        body: JSON.stringify(usuario) // Convert the JavaScript object to a JSON string
                    })
                    
                }
                visualizar();
                telaPopupCadastro.classList.add("ocultaTelaPopupCadastro");
                console.log('Inserindo novo Usuario: ', listaUsuarios);
            }
            function limpaForm(){
                nome.value = '';
                cpf.value = '';
                dataNascimento.value = '';
                email.value = '';
                telefone.value = '';
                nivel.value = '';
                situacao.value = '';
            }
            function visualizar() {
                console.log("Visualizando Registro do Usuário");
                fetch('/administracao/usuarios')
                    .then(response => {
                        // Check if the request was successful (status code 200-299)
                        if (!response.ok) {
                            throw new Error(`HTTP error! status: ${response.status}`);
                        }
                        // Parse the response body as JSON
                        return response.json();
                    })
                    .then(data => {
                        // Work with the fetched data
                        listaUsuarios.value = data;
                    })
                    .catch(error => {
                        // Handle any errors during the fetch operation
                        console.error('There was a problem with the fetch operation:', error);
                    });
            }

            function editar(idUsuario){
                console.log("Editando Registro do Usuário");
                const url = `/administracao/usuarios/${idUsuario}` 
                fetch(url)
                    .then(response => {
                        // Check if the request was successful (status code 200-299)
                        if (!response.ok) {
                            throw new Error(`HTTP error! status: ${response.status}`);
                        }
                        // Parse the response body as JSON
                        return response.json();
                    })
                    .then(data => {
                        // Work with the fetched data
                        id.value = idUsuario;
                        nome.value = data.nome;
                        cpf.value = data.cpf;
                        dataNascimento.value = data.dataNascimento;
                        email.value = data.email;
                        telefone.value = data.telefone;
                        nivel.value = data.nivel;   
                        situacao.value = data.situacao;
                    })
                    .catch(error => {
                        // Handle any errors during the fetch operation
                        console.error('There was a problem with the fetch operation:', error);
                    });
                
                telaPopupCadastro.classList.remove("ocultaTelaPopupCadastro");
            }
            function excluir(){
                console.log("Excluindo Registro do Usuário");
            }
            visualizar()
            return {
                processaForm,
                listaUsuarios,
                visualizar,
                editar,
                excluir,
                limpaForm
            }
        }
    }).mount('main')
</script>
