            setup() {
                
                // const router = useRouter();
                
                async function processaForm(){
                    console.log('Entrando em processa form')
                    let informacoesLogin={
                        email: email.value,
                        senha: senha.value
                    }
                    await fetch('/login', {
                        method: 'POST', // Specify the HTTP method as POST
                        headers: {
                            'Content-Type': 'application/json' // Indicate that the body is JSON
                        },
                        body: JSON.stringify(informacoesLogin) // Convert the JavaScript object to a JSON string
                    });
