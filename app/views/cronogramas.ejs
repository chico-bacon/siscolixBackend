<html lang="pt-br">
<body>
    <%- include('cabecalho') %>

    <main class="telaPrincipal">
        <div class="cabecalhoTela">
            <div class="cabecalhoTelaLeft">
                <div class="tituloCabecalho">
                    <h1>Cronograma de Coleta Diária</h1>
                </div>
                <div class="iconeTela">
                    <img src="img\fotos\sacolixo.png" alt="">
                </div>
            </div>
            <div class="cabecalhoTelaRight">
                <div class="pesquisaCronogramaBairros">
                    <label for="pesquisa">Pesquisar Bairro</label>
                    <input type="text" name="pesquisa">
                    <button><img src="img\icons\search.svg" alt="Pesquisar"></button>
                </div>
            </div>
        </div>
        <div class="gridCronograma">
            <table >
                <tr>
                    <th><h3>Bairro</h3></th>
                    <th><h3>Periodicidade</h3></th>
                    <th><h3>Turno</h3></th>
                </tr>
                <tbody  class="linhasCronograma">   
                    <tr v-for="cronograma in listaCronogramas" :key="cronograma.id">
                        <td>{{ cronograma.bairro }}</td>
                        <td>{{ cronograma.periodicidade }}</td>
                        <td>{{ cronograma.turno }}</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </main>

    <script type="module">
    import { createApp, ref, reactive } from 'https://unpkg.com/vue@3/dist/vue.esm-browser.prod.js'

    createApp({
        setup() {
            let id=1;
            let listaCronogramas = reactive([
                {id: 1, bairro: "Centro Bairro", periodicidade: "Segunda - Quarta - Sexta", turno: "Manhã"},
                {id: 2, bairro: "Coréia", periodicidade: "Terça - Quinta - Sábado", turno: "Tarde"},
                {id: 3, bairro: "Centro Matriz", periodicidade: "Segunda a Domingo", turno: "Manhã - Tarde"},
                {id: 4, bairro: "Campo de Aviação", periodicidade: "Segunda a Sábado", turno: "Tarde"},
                {id: 5, bairro: "Lagoa", periodicidade: "Segunda - Quarta - Sábado", turno: "Tarde"},
                {id: 6, bairro: "Alagadiço", periodicidade: "Terça - Sábado", turno: "Manhã"}
            ]);
            return {
                listaCronogramas
            }
        }
    }).mount('main')
    </script>

    <%- include('rodape') %>
</body>
</html>